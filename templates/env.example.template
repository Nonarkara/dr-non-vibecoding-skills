# Copy to <project>/.env.example — committed. Never commit the real .env.
# Values are empty; each line points to where the key comes from.
# See reference/free-apis.md for the full catalog; this is the starter set
# covering the most-used free tiers plus the infra you already have.

# === App ===
NODE_ENV=development
PORT=3000
# DATABASE_URL=postgresql://user:pass@host/db   # or leave empty for SQLite/file
# APP_DB_PATH=/Volumes/Data/myapp/myapp.db      # external volume; see always-on-services

# === AI (pick one; local Ollama needs none) ===
# GROQ_API_KEY=            # https://console.groq.com
# OPENROUTER_API_KEY=      # https://openrouter.ai
# ANTHROPIC_API_KEY=       # https://console.anthropic.com

# === Cloudflare — deploy & tunnels ===
# CLOUDFLARE_API_TOKEN=    # https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_ACCOUNT_ID=
# TUNNEL_TOKEN=            # cloudflared tunnel token (per-tunnel, from `cloudflared tunnel create`)

# === Maps ===
# MAPBOX_ACCESS_TOKEN=     # https://account.mapbox.com
# MAPTILER_API_KEY=        # https://cloud.maptiler.com/account/keys

# === Optional data sources (add only what you use) ===
# OPENWEATHERMAP_API_KEY=  # https://openweathermap.org/api
# FRED_API_KEY=            # https://fred.stlouisfed.org/docs/api
# NASA_FIRMS_API_KEY=      # https://firms.modaps.eosdis.nasa.gov/api/area
# WORLD_BANK_API_KEY=      # usually none — World Bank is no-key
