#!/usr/bin/env bash
# ==============================================================================
# Dr Non Secrets & Cyber Hygiene Audit
# Copy to <project>/scripts/secrets-audit.sh and chmod +x.
# Run before every commit + weekly in CI. No external deps (uses ripgrep if
# present, otherwise falls back to grep -r). Honors .gitignore.
#
# Catches:
#   - AWS access keys, GitHub PATs, Stripe keys, Slack tokens, generic API tokens
#   - Committed .env files
#   - Hardcoded passwords in source
#   - Public URLs in code (http://, no https)
#   - Missing CORS / CSP / X-Frame-Options on HTML surfaces
#
# Exit code: 0 if clean, 1 if any high-severity finding, 2 if only warnings.
# ==============================================================================
set -euo pipefail

PROJECT_ROOT="${1:-.}"
cd "$PROJECT_ROOT"

# Severity
HIGH=0
WARN=0
FINDINGS=()

# --- Helpers ----------------------------------------------------------------
has() { command -v "$1" >/dev/null 2>&1; }
say() { echo "  $*"; }
fail() { HIGH=$((HIGH + 1)); FINDINGS+=("HIGH: $*"); echo "  ❌ $*"; }
warn() { WARN=$((WARN + 1)); FINDINGS+=("WARN: $*"); echo "  ⚠️  $*"; }

secret_files() {
  local pattern="$1"
  if has rg; then
    rg --files-with-matches --hidden \
      --glob '!.git/*' --glob '!node_modules/**' --glob '!vendor/**' \
      --glob '!dist/**' --glob '!build/**' "$pattern" . 2>/dev/null || true
  else
    find . -type f \
      -not -path './.git/*' -not -path './node_modules/*' \
      -not -path './vendor/*' -not -path './dist/*' -not -path './build/*' \
      -exec grep -IlE "$pattern" {} + 2>/dev/null || true
  fi
}

http_hits() {
  if has rg; then
    rg --no-heading --line-number --hidden --glob '!.git/*' \
      --glob '!node_modules/**' --glob '!*.template' --glob "!${SELF}" \
      --glob '*.{html,htm,js,mjs,cjs,ts,tsx,jsx,vue,svelte,py,rb,go,rs,java,kt,swift,css,json,yml,yaml,toml}' \
      'http://[A-Za-z0-9]' . 2>/dev/null || true
  else
    grep -RInE --exclude-dir=.git --exclude-dir=node_modules \
      --exclude='*.template' --exclude="${SELF}" \
      --include='*.html' --include='*.htm' --include='*.js' --include='*.mjs' \
      --include='*.cjs' --include='*.ts' --include='*.tsx' --include='*.jsx' \
      --include='*.vue' --include='*.svelte' --include='*.py' --include='*.rb' \
      --include='*.go' --include='*.rs' --include='*.java' --include='*.kt' \
      --include='*.swift' --include='*.css' --include='*.json' --include='*.yml' \
      --include='*.yaml' --include='*.toml' 'http://[A-Za-z0-9]' . 2>/dev/null || true
  fi
}

echo "▶ Dr Non Secrets & Cyber Hygiene Audit"
echo "  Project: $(pwd)"
echo

# 1. Staged-files gate ------------------------------------------------------
if has git && [[ -d .git ]]; then
  STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
  if [[ -n "$STAGED" ]]; then
    say "Scanning $(echo "$STAGED" | wc -l | tr -d ' ') staged file(s)..."
    SENSITIVE_STAGED=$(echo "$STAGED" \
      | grep -E '(^|/)\.env(\.|$)|\.pem$|\.key$|id_rsa|credentials\.json$' \
      | grep -vE '(^|/)\.env\.example$' \
      || true)
    if [[ -n "$SENSITIVE_STAGED" ]]; then
      fail "Sensitive file staged in git: $SENSITIVE_STAGED"
    fi
  else
    say "No staged files (run with files staged for full coverage)."
  fi
else
  say "Not a git repo — skipping staged-files gate."
fi

# 2. Secret-pattern scan (source + config, not vendor) ----------------------
say "Scanning source for secret patterns (filenames only; values stay redacted)..."
PATTERNS=(
  'AKIA[0-9A-Z]{16}'                                         # AWS access key
  'aws_secret_access_key\s*='                                # AWS secret
  'ghp_[A-Za-z0-9]{30,}'                                     # GitHub PAT (classic)
  'github_pat_[A-Za-z0-9_]{30,}'                             # GitHub PAT (fine)
  'sk_live_[A-Za-z0-9]{20,}'                                 # Stripe live
  'sk_test_[A-Za-z0-9]{20,}'                                 # Stripe test
  'xox[baprs]-[A-Za-z0-9-]{10,}'                             # Slack tokens
  'AIza[0-9A-Za-z_-]{35}'                                    # Google API key
  'sk-[A-Za-z0-9]{20,}'                                      # OpenAI
  '-----BEGIN (RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----' # Private keys
  'password\s*[:=]\s*["'\''][^"'\'' ]{6,}["'\'']'             # Generic password =
)

SECRET_HITS=0
for p in "${PATTERNS[@]}"; do
  HITS="$(secret_files "$p")"
  if [[ -n "$HITS" ]]; then
    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      fail "Potential secret found in $file (matched a redacted detector)"
      SECRET_HITS=$((SECRET_HITS + 1))
    done <<< "$HITS"
  fi
done
if (( SECRET_HITS == 0 )); then
  say "No secret-pattern hits."
fi

# 3. .env hygiene ------------------------------------------------------------
if [[ -f .env ]]; then
  if has git && git ls-files --error-unmatch .env >/dev/null 2>&1; then
    fail ".env is tracked by git — remove it from the index and rotate any exposed values."
  elif has git && git check-ignore -q .env 2>/dev/null; then
    say "Local .env exists and is ignored."
  else
    warn ".env exists but is not ignored — add it to .gitignore before the next git add."
  fi
fi
if [[ ! -f .env.example ]]; then
  warn ".env.example missing — every secret-bearing project should document the contract."
fi

# 4. Public URL scan (no http:// in shipped code) ---------------------------
# Skip our own script (its comments contain http://) and any *.template file.
say "Checking for plaintext http:// URLs in source..."
SELF="$(basename "$0")"
HTTP_HITS=$(http_hits \
  | grep -vE '(localhost|127\.0\.0\.1|0\.0\.0\.0|example\.com|schema|xmlns|w3\.org|github\.com/.*/(issues|discussions|pulls)|localhost:[0-9])' \
  | grep -vE ':\s*#' \
  || true)
if [[ -n "$HTTP_HITS" ]]; then
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    warn "Plaintext http:// in shipped code: $line"
  done <<< "$HTTP_HITS"
fi

# 5. HTML/headers check ------------------------------------------------------
HTML_FILES=$(find . -type f \( -name '*.html' -o -name '*.htm' \) -not -path './.git/*' -not -path './node_modules/*' 2>/dev/null || true)
if [[ -n "$HTML_FILES" ]]; then
  say "Found $(echo "$HTML_FILES" | wc -l | tr -d ' ') HTML file(s); checking for security meta..."
  for f in $HTML_FILES; do
    if ! grep -q 'Content-Security-Policy' "$f" 2>/dev/null; then
      warn "$f: missing Content-Security-Policy meta"
    fi
  done
fi

# 6. Summary -----------------------------------------------------------------
echo
if (( HIGH > 0 )); then
  echo "❌ Audit FAILED with $HIGH high-severity finding(s) and $WARN warning(s)."
  printf '  %s\n' "${FINDINGS[@]}"
  exit 1
elif (( WARN > 0 )); then
  echo "⚠️  Audit passed with $WARN warning(s) — review recommended."
  printf '  %s\n' "${FINDINGS[@]}"
  exit 2
else
  echo "✅ Audit clean — no secrets, no plaintext URLs, all HTML files have CSP."
  exit 0
fi
