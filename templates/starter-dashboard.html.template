<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src https://api.open-meteo.com https://earthquake.usgs.gov https://api.frankfurter.app; img-src 'self' data:; base-uri 'none'; form-action 'none'">
  <title><Project> — Operations Dashboard</title>
  <style>
    /* Axiom Design Core — Rams/Braun Lineage: 0px radius, hairlines, single amber accent */
    :root {
      --bg: #0a0a0a;
      --surface: #141414;
      --surface-hover: #1a1a1a;
      --border: #262626;
      --border-subtle: #1f1f1f;
      --text: #ededed;
      --text-muted: #a1a1aa;
      --text-dim: #71717a;
      --accent: #f59e0b; /* Amber */
      --accent-dim: rgba(245, 158, 11, 0.12);
      --success: #10b981;
      --danger: #ef4444;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding: 24px;
    }

    /* Layout */
    .container {
      max-width: 1100px;
      margin: 0 auto;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      border-bottom: 1px solid var(--border);
      padding-bottom: 16px;
      margin-bottom: 24px;
    }
    .header-left h1 {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .header-left p {
      color: var(--text-muted);
      font-size: 0.8125rem;
      margin-top: 4px;
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 8px;
      background: var(--surface);
      border: 1px solid var(--border);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .status-dot {
      width: 6px;
      height: 6px;
      background-color: var(--text-dim);
    }

    .status-badge[data-state="complete"] .status-dot { background-color: var(--success); }
    .status-badge[data-state="partial"] .status-dot { background-color: var(--accent); }
    .status-badge[data-state="unavailable"] .status-dot { background-color: var(--danger); }

    /* Grid */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    /* Card */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 16px;
      position: relative;
    }
    .card:hover {
      border-color: #333333;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 4px 8px;
    }
    .card-title {
      font-size: 0.8125rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }
    .card-meta {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-dim);
    }
    .stat-hero {
      font-family: var(--font-mono);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 8px;
    }
    .stat-detail {
      font-size: 0.8125rem;
      color: var(--text-muted);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .stat-row {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px dashed var(--border-subtle);
      padding-bottom: 2px;
    }
    .stat-row:last-child {
      border-bottom: none;
    }
    .stat-val {
      font-family: var(--font-mono);
      color: var(--text);
    }

    /* Instructions callout for AI pairing */
    .agent-box {
      border: 1px dashed var(--border);
      background: rgba(20, 20, 20, 0.6);
      padding: 16px;
      margin-top: 32px;
      font-size: 0.8125rem;
      color: var(--text-muted);
    }
    .agent-box strong {
      color: var(--accent);
    }
    .code-pill {
      font-family: var(--font-mono);
      background: #1f1f1f;
      padding: 2px 6px;
      color: var(--text);
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <div class="header-left">
        <h1><span>▲</span> <Project></h1>
        <p><one sentence: what it is and who it's for></p>
      </div>
      <div class="header-right">
        <div class="status-badge" id="system-status" data-state="pending" role="status" aria-live="polite">
          <div class="status-dot" aria-hidden="true"></div>
          <span id="status-text">NOT FETCHED</span>
        </div>
      </div>
    </header>

    <!-- PUBLIC DATA SNAPSHOTS -->
    <div class="grid">
      <!-- Card 1: Weather Snapshot (Open-Meteo, zero-auth) -->
      <div class="card" id="card-weather">
        <div class="card-header">
          <span class="card-title">Atmospheric Conditions</span>
          <span class="card-meta" id="weather-meta">OPEN-METEO · NOT FETCHED</span>
        </div>
        <div class="stat-hero" id="weather-temp">--°C</div>
        <div class="stat-detail">
          <div class="stat-row">
            <span>Wind Speed</span>
            <span class="stat-val" id="weather-wind">-- km/h</span>
          </div>
          <div class="stat-row">
            <span>Wind Direction</span>
            <span class="stat-val" id="weather-dir">--°</span>
          </div>
          <div class="stat-row">
            <span>Coordinates</span>
            <span class="stat-val">13.75°N, 100.51°E</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Seismic Monitor (USGS Earthquakes, zero-auth) -->
      <div class="card" id="card-seismic">
        <div class="card-header">
          <span class="card-title">Recent Seismic Event</span>
          <span class="card-meta" id="quake-meta">USGS M4.5+ · NOT FETCHED</span>
        </div>
        <div class="stat-hero" id="quake-mag">M --</div>
        <div class="stat-detail">
          <div class="stat-row">
            <span>Location</span>
            <span class="stat-val" id="quake-place">No data fetched</span>
          </div>
          <div class="stat-row">
            <span>Recorded Time</span>
            <span class="stat-val" id="quake-time">--</span>
          </div>
          <div class="stat-row">
            <span>Depth</span>
            <span class="stat-val" id="quake-depth">-- km</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Currency Rates (Frankfurter ECB, zero-auth) -->
      <div class="card" id="card-fx">
        <div class="card-header">
          <span class="card-title">Foreign Exchange</span>
          <span class="card-meta" id="fx-meta">ECB / FRANKFURTER · NOT FETCHED</span>
        </div>
        <div class="stat-hero" id="fx-rate">-- THB</div>
        <div class="stat-detail">
          <div class="stat-row">
            <span>1 USD → EUR</span>
            <span class="stat-val" id="fx-eur">--</span>
          </div>
          <div class="stat-row">
            <span>1 USD → JPY</span>
            <span class="stat-val" id="fx-jpy">--</span>
          </div>
          <div class="stat-row">
            <span>Base Benchmark</span>
            <span class="stat-val">USD (1.00)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- AI AGENT & BUILDER HANDSHAKE -->
    <div class="agent-box">
      <strong>Vibe Coder Guidance:</strong> This starter dashboard runs 100% in your browser without backend setup.
      To customize, open this folder in <strong>Claude Code</strong>, <strong>Cursor</strong>, or <strong>Antigravity</strong> and say:
      <br><br>
      <em>"Modify index.html to show a live crypto price ticker using CoinGecko and switch the weather coordinates to Tokyo."</em>
      <br><br>
      Contracts and invariants are maintained in <span class="code-pill">CLAUDE.md</span> and <span class="code-pill">AGENTS.md</span>.
    </div>
  </div>

  <script>
    // A successful request is a snapshot, not proof of real-time observations.
    async function safeFetch(url) {
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
      } catch (err) {
        console.warn('Feed unavailable:', err);
        return null;
      }
    }

    async function loadDashboard() {
      const setText = (id, text) => { document.getElementById(id).textContent = text; };
      const badge = document.getElementById('system-status');
      badge.dataset.state = 'pending';
      setText('status-text', 'FETCHING SNAPSHOT');
      // Reset before any retry so yesterday's value cannot look newly fetched.
      for (const [id, value] of Object.entries({
        'weather-temp': '--°C', 'weather-wind': '-- km/h', 'weather-dir': '--°',
        'quake-mag': 'M --', 'quake-place': 'No usable data',
        'quake-depth': '-- km', 'quake-time': '--',
        'fx-rate': '-- THB', 'fx-eur': '--', 'fx-jpy': '--',
        'weather-meta': 'OPEN-METEO · PENDING',
        'quake-meta': 'USGS M4.5+ · PENDING',
        'fx-meta': 'ECB / FRANKFURTER · PENDING'
      })) setText(id, value);
      let available = 0;

      // 1. Open-Meteo current-weather snapshot. Keep the provider's timestamp.
      const weatherData = await safeFetch('https://api.open-meteo.com/v1/forecast?latitude=13.75&longitude=100.51&current_weather=true');
      setText('weather-meta', 'OPEN-METEO · UNAVAILABLE');
      const w = weatherData?.current_weather;
      if (w && [w.temperature, w.windspeed, w.winddirection].every(Number.isFinite)) {
        setText('weather-temp', `${w.temperature}°C`);
        setText('weather-wind', `${w.windspeed} km/h`);
        setText('weather-dir', `${w.winddirection}°`);
        const time = typeof w.time === 'string' && w.time ? w.time : 'time unknown';
        setText('weather-meta', `OPEN-METEO · ${time}`);
        available++;
      }

      // 2. An empty, valid USGS list means no matching events, not a live event.
      const quakeData = await safeFetch('https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&minmagnitude=4.5&limit=1');
      setText('quake-meta', 'USGS M4.5+ · UNAVAILABLE');
      if (Array.isArray(quakeData?.features)) {
        const q = quakeData.features[0];
        if (quakeData.features.length === 0) {
          setText('quake-meta', 'USGS M4.5+ · NO MATCHING EVENTS');
          setText('quake-place', 'No events in this response');
          available++;
        } else if (Number.isFinite(q?.properties?.mag) &&
                   Number.isFinite(q?.geometry?.coordinates?.[2]) &&
                   Number.isFinite(q?.properties?.time) &&
                   Number.isFinite(new Date(q.properties.time).getTime())) {
          setText('quake-mag', `M ${q.properties.mag.toFixed(1)}`);
          setText('quake-place', typeof q.properties.place === 'string' && q.properties.place
            ? q.properties.place : 'Location unavailable');
          setText('quake-depth', `${q.geometry.coordinates[2]} km`);
          setText('quake-time', new Date(q.properties.time).toISOString());
          setText('quake-meta', 'USGS M4.5+ · EVENT SNAPSHOT');
          available++;
        }
      }

      // 3. ECB reference rates are dated observations, not streaming FX prices.
      const fxData = await safeFetch('https://api.frankfurter.app/latest?from=USD&to=THB,EUR,JPY');
      setText('fx-meta', 'ECB / FRANKFURTER · UNAVAILABLE');
      const rates = fxData?.rates;
      if (rates && [rates.THB, rates.EUR, rates.JPY].every(value => Number.isFinite(value) && value > 0)) {
        setText('fx-rate', `${rates.THB.toFixed(2)} THB`);
        setText('fx-eur', rates.EUR.toFixed(4));
        setText('fx-jpy', rates.JPY.toFixed(2));
        const date = typeof fxData.date === 'string' && fxData.date ? fxData.date : 'date unknown';
        setText('fx-meta', `ECB / FRANKFURTER · ${date}`);
        available++;
      }

      badge.dataset.state = available === 3 ? 'complete' : available ? 'partial' : 'unavailable';
      const label = available === 3 ? 'SNAPSHOT' : available ? 'PARTIAL' : 'UNAVAILABLE';
      setText('status-text', `${label} · ${available}/3 FEEDS`);
    }

    // Initialize on page load
    window.addEventListener('DOMContentLoaded', loadDashboard);
  </script>
</body>
</html>
