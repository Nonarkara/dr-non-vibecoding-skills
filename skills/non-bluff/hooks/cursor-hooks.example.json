{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10, "failClosed": true }
    ],
    "beforeMCPExecution": [
      { "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10, "failClosed": true }
    ],
    "beforeReadFile": [
      { "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10, "failClosed": true }
    ],
    "preToolUse": [
      { "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "matcher": "Write|Delete", "timeout": 10, "failClosed": true }
    ],
    "afterShellExecution": [{ "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10 }],
    "afterMCPExecution": [{ "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10 }],
    "afterFileEdit": [{ "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10 }],
    "afterAgentResponse": [{ "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10 }],
    "stop": [{ "command": "python3 .cursor/skills/non-bluff/scripts/non-bluff-guard", "timeout": 10, "loop_limit": 3 }]
  }
}
